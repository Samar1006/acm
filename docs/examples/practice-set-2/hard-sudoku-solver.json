{
  "title": "Sudoku Solver",
  "description": "A Sudoku board is given as a list of 9 strings, one per row from top to bottom. Each string has 9 characters: a digit `1` to `9`, or `.` for an empty cell.\n\nFill in every empty cell so that each row, each column, and each of the nine 3 by 3 boxes contains the digits `1` to `9` exactly once. Return the completed board in the same format.\n\nEvery test has exactly one solution.\n\n### Constraints\n\n- `board.size() == 9` and every row has exactly 9 characters.\n- Every character is a digit `1` to `9` or `.`.\n- Inputs are passed as function arguments and the answer is returned from the function. Do not read from standard input or print the result.\n",
  "reference": "bool fill(vector<string>& board, bool rows[9][9], bool cols[9][9], bool boxes[9][9]) {\n    int best_r = -1, best_c = -1, best_count = 10;\n    for (int r = 0; r < 9; ++r) {\n        for (int c = 0; c < 9; ++c) {\n            if (board[r][c] != '.') {\n                continue;\n            }\n            int count = 0;\n            for (int d = 0; d < 9; ++d) {\n                if (!rows[r][d] && !cols[c][d] && !boxes[(r / 3) * 3 + c / 3][d]) {\n                    ++count;\n                }\n            }\n            if (count < best_count) {\n                best_count = count;\n                best_r = r;\n                best_c = c;\n            }\n        }\n    }\n    if (best_r < 0) {\n        return true;\n    }\n    int b = (best_r / 3) * 3 + best_c / 3;\n    for (int d = 0; d < 9; ++d) {\n        if (rows[best_r][d] || cols[best_c][d] || boxes[b][d]) {\n            continue;\n        }\n        rows[best_r][d] = cols[best_c][d] = boxes[b][d] = true;\n        board[best_r][best_c] = (char)('1' + d);\n        if (fill(board, rows, cols, boxes)) {\n            return true;\n        }\n        rows[best_r][d] = cols[best_c][d] = boxes[b][d] = false;\n        board[best_r][best_c] = '.';\n    }\n    return false;\n}\n\nvector<string> solve_sudoku(vector<string> board) {\n    bool rows[9][9] = {}, cols[9][9] = {}, boxes[9][9] = {};\n    for (int r = 0; r < 9; ++r) {\n        for (int c = 0; c < 9; ++c) {\n            if (board[r][c] != '.') {\n                int d = board[r][c] - '1';\n                rows[r][d] = cols[c][d] = boxes[(r / 3) * 3 + c / 3][d] = true;\n            }\n        }\n    }\n    fill(board, rows, cols, boxes);\n    return board;\n}\n",
  "template": "vector<string> solve_sudoku(vector<string> board) {\n    // Return the completed board.\n    return {};\n}\n",
  "tags": [
    "Backtracking",
    "Matrix",
    "Hash Tables"
  ],
